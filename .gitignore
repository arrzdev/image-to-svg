.venv/
__pycache__/
*.pyc
svgcore/target/
outputs/
!outputs/.gitkeep
.DS_Store
*.egg-info/
data/outputs/*
!data/outputs/.gitkeep

# autoresearch loop — runtime sentinels & snapshots (state itself is tracked:
# autoresearch.md, autoresearch.jsonl, autoresearch.focus, experiments/worklog.md)
.autoresearch-off
.autoresearch-inspect
autoresearch-dashboard.md
autoresearch-report.md
experiments/*.bak
experiments/autoresearch.jsonl.precompact.bak
# worktree-parallel iterations: transient in-flight state + the worktrees dir
# (durable record lives in RESEARCH_LOG / jsonl / worklog / git history)
autoresearch.iteration.json
.autoresearch-worktrees/

# scratch experiment renders (regenerable)
experiments/*.svg
