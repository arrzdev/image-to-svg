.venv/
__pycache__/
*.pyc
svgcore/target/
outputs/
!outputs/.gitkeep
.DS_Store
*.egg-info/
data/outputs/*
!data/outputs/.gitkeep

# autoresearch loop — runtime sentinels & snapshots (state itself is tracked:
# autoresearch.md, autoresearch.jsonl, autoresearch.focus, experiments/worklog.md)
.autoresearch-off
.autoresearch-inspect
research/autoresearch-dashboard.md
research/autoresearch-report.md
research/*.bak
research/autoresearch.jsonl.precompact.bak
# worktree-parallel iterations: transient in-flight state + the worktrees dir
# (durable record lives in RESEARCH_LOG / jsonl / worklog / git history)
research/autoresearch.iteration.json
research/autoresearch.iteration.json.precompact.bak
.autoresearch-worktrees/


# per-iteration scratch artifacts (candidate svgs, baselines, grids)
research/it*/
research/it15_baseline_*.svg
.claude/worktrees/

# tilecmp diagnostic artifacts (regeneratable in seconds)
research/design/tilecmp_out/
research/design/.tilecmp_cache/
research/design/.loop_state.json
research/design/.loop_patch.diff
